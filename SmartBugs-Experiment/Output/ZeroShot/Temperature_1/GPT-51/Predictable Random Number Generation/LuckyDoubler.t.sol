pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {LuckyDoubler} from "../src/LuckyDoubler.sol";

contract TestWeakRandomnessLuckyDoubler is Test {
    LuckyDoubler lucky;

    uint256 constant private FACTOR = 1157920892373161954235709850086879078532699846656405640394575840079131296399;

    function setUp() public {
        lucky = new LuckyDoubler();
    }

    function _predictIndex(uint256 max) internal view returns (uint256) {
        uint256 factor = FACTOR * 100 / max;
        uint256 lastBlockNumber = block.number - 1;
        uint256 hashVal = uint256(blockhash(lastBlockNumber));
        return uint256((hashVal / factor)) % max;
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber > 1);

        vm.roll(blockNumber);

        address player = address(0xBEEF);
        vm.deal(player, 10 ether);

        vm.prank(player);
        (bool success1,) = address(lucky).call{value: 1 ether}("");
        require(success1, "first deposit failed");

        uint256 expectedIndex = _predictIndex(2);

        vm.prank(player);
        (bool success2,) = address(lucky).call{value: 1 ether}("");
        require(success2, "second deposit failed");

        (, , bool paid0, ) = lucky.entryDetails(0);
        (, , bool paid1, ) = lucky.entryDetails(1);

        assertEq(paid0, expectedIndex == 0);
        assertEq(paid1, expectedIndex == 1);
    }
}
