pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {BlackJack} from "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public blackJack;

    function setUp() public {
        blackJack = new BlackJack();
        vm.deal(address(blackJack), 100 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockTimestamp, uint256 blockNumber) public {
        vm.assume(blockTimestamp > 0 && blockTimestamp < type(uint128).max);
        vm.assume(blockNumber > 0 && blockNumber < type(uint128).max);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        address player = address(this);
        vm.deal(player, 10 ether);

        bytes32 currentBlockhash = blockhash(block.number);

        uint8 predictedPlayerCard0 = uint8(uint256(keccak256(abi.encodePacked(currentBlockhash, player, uint8(0), block.timestamp))) % 52);
        uint8 predictedHouseCard0 = uint8(uint256(keccak256(abi.encodePacked(currentBlockhash, player, uint8(1), block.timestamp))) % 52);
        uint8 predictedPlayerCard1 = uint8(uint256(keccak256(abi.encodePacked(currentBlockhash, player, uint8(2), block.timestamp))) % 52);

        vm.recordLogs();

        blackJack.deal{value: 0.05 ether}();

        Vm.Log[] memory logs = vm.getRecordedLogs();

        bytes32 dealEventSelector = keccak256("Deal(bool,uint8)");

        uint8 actualPlayerCard0;
        uint8 actualHouseCard0;
        uint8 actualPlayerCard1;
        uint8 dealEventCount = 0;

        for (uint i = 0; i < logs.length; i++) {
            if (logs[i].topics[0] == dealEventSelector) {
                (bool isUser, uint8 card) = abi.decode(logs[i].data, (bool, uint8));
                if (dealEventCount == 0) {
                    actualPlayerCard0 = card;
                    assertTrue(isUser, "First deal should be to player");
                } else if (dealEventCount == 1) {
                    actualHouseCard0 = card;
                    assertFalse(isUser, "Second deal should be to house");
                } else if (dealEventCount == 2) {
                    actualPlayerCard1 = card;
                    assertTrue(isUser, "Third deal should be to player");
                }
                dealEventCount++;
            }
        }

        assertEq(dealEventCount, 3, "Should have exactly 3 Deal events");

        assertEq(actualPlayerCard0, predictedPlayerCard0, "Player card 0 should be predictable");
        assertEq(actualHouseCard0, predictedHouseCard0, "House card 0 should be predictable");
        assertEq(actualPlayerCard1, predictedPlayerCard1, "Player card 1 should be predictable");
    }

    function test_correlationCheck_sameBlockSameResult(uint256 blockTimestamp, uint256 blockNumber) public {
        vm.assume(blockTimestamp > 0 && blockTimestamp < type(uint128).max);
        vm.assume(blockNumber > 0 && blockNumber < type(uint128).max);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        address player1 = address(0x1111);
        address player2 = address(0x1111);
        vm.deal(player1, 10 ether);

        bytes32 dealEventSelector = keccak256("Deal(bool,uint8)");

        vm.prank(player1);
        vm.recordLogs();
        blackJack.deal{value: 0.05 ether}();
        Vm.Log[] memory logs1 = vm.getRecordedLogs();

        uint8 firstCallCard0;
        for (uint i = 0; i < logs1.length; i++) {
            if (logs1[i].topics[0] == dealEventSelector) {
                (, uint8 card) = abi.decode(logs1[i].data, (bool, uint8));
                firstCallCard0 = card;
                break;
            }
        }

        bytes32 currentBlockhash = blockhash(block.number);
        uint8 predictedCard = uint8(uint256(keccak256(abi.encodePacked(currentBlockhash, player1, uint8(0), block.timestamp))) % 52);

        assertEq(firstCallCard0, predictedCard, "Card dealt should match prediction within same block");
    }

    function test_blockhashOfCurrentBlockIsZero(uint256 blockNumber) public {
        vm.assume(blockNumber > 0 && blockNumber < type(uint128).max);
        vm.roll(blockNumber);

        bytes32 currentBlockhash = blockhash(block.number);
        
        assertEq(currentBlockhash, bytes32(0), "blockhash of current block should be zero, making randomness more predictable");
    }

