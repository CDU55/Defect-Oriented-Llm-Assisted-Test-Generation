        uint256 balanceAfter = address(this).balance;

        assertEq(balanceAfter - balanceBefore, 2 ether, "Attacker should win by predicting blockhash of 0");

        assertEq(preCalculatedResult, predictedAnswer, "Pre-calculated answer matches the guess, proving predictability");
