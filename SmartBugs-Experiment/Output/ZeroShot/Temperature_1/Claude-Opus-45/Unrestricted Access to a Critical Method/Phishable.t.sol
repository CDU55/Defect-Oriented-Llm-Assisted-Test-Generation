        vm.assume(caller != owner);
        
        // Ensure caller can receive ETH
        vm.assume(caller.code.length == 0);
        
        // Record initial balances
        uint256 initialContractBalance = address(phishable).balance;
        uint256 callerInitialBalance = caller.balance;
        
        // Create attacker contract that will redirect funds to arbitrary caller
        AttackContract attackContract = new AttackContract(address(phishable), payable(caller));
        
        // Simulate owner being phished into calling attacker's contract
        // vm.prank(sender, origin) sets both msg.sender and tx.origin
        // When owner calls attackContract.attack():
