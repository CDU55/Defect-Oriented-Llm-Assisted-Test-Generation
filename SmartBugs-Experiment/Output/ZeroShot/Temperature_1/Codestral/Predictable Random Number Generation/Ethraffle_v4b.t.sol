pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import "../src/Ethraffle_v4b.sol";

contract TestWeakRandomnessEthraffle_v4b is Test {

    Ethraffle_v4b public ethraffle;

    function setUp() public {
        ethraffle = new Ethraffle_v4b();
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber, address blockCoinbase, uint256 blockDifficulty) public {
        vm.assume(blockNumber > 0);
        vm.assume(blockDifficulty > 0);

        vm.startPrank(address(0x1));
        vm.deal(address(0x1), 10 ether);
        vm.stopPrank();

        vm.roll(blockNumber);
        vm.rollFork(blockNumber);
        vm.warp(block.timestamp);
        vm.fee(1 ether);
        vm.setBlockGasLimit(10000000);

        address seed1 = address(uint160(blockCoinbase));
        address seed2 = address(uint160(address(0x1)));
        uint seed3 = blockDifficulty;
        bytes32 randHash = keccak256(abi.encodePacked(seed1, seed2, seed3));
        uint expectedWinningNumber = uint(randHash) % 50;

        vm.prank(address(0x1));
        ethraffle.buyTickets{value: 50 * 0.05 ether}();

        uint actualWinningNumber = ethraffle.raffleId() - 1;

        assertEq(actualWinningNumber, expectedWinningNumber);
    }
}
