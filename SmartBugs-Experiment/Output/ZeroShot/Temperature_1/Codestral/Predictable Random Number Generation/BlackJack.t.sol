pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {BlackJack} from "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public blackJack;

    function setUp() public {
        blackJack = new BlackJack();
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber, uint256 blockTimestamp) public {
        vm.assume(blockNumber < type(uint32).max);
        vm.assume(blockTimestamp < type(uint32).max);

        vm.startPrank(address(1));
        vm.deal(address(1), 1 ether);
        vm.stopPrank();

        vm.roll(blockNumber);
        vm.warp(blockTimestamp);

        vm.startPrank(address(1));
        blackJack.deal{value: 0.1 ether}();

        uint8 card1 = blackJack.getPlayerCard(0);
        uint8 card2 = blackJack.getPlayerCard(1);
        uint8 houseCard = blackJack.getHouseCard(0);

        uint8 expectedCard1 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(1), 0, blockTimestamp))) % 52);
        uint8 expectedCard2 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(1), 2, blockTimestamp))) % 52);
        uint8 expectedHouseCard = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(1), 1, blockTimestamp))) % 52);

        assertEq(card1, expectedCard1, "First card prediction failed");
        assertEq(card2, expectedCard2, "Second card prediction failed");
        assertEq(houseCard, expectedHouseCard, "House card prediction failed");

        vm.stopPrank();
    }
}
