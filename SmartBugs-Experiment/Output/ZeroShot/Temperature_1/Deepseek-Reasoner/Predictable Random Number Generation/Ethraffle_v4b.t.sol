        address seed2 = address(uint160(uint256(keccak256(abi.encode(attacker)))) % totalTickets);
        uint256 seed3 = blockPrevrandao;
        bytes32 expectedRandHash = keccak256(abi.encodePacked(seed1, seed2, seed3));
        uint256 expectedWinningNumber = uint256(expectedRandHash) % totalTickets;

        Vm.Log[] memory entries = vm.getRecordedLogs();
        bytes32 raffleResultSignature = keccak256("RaffleResult(uint256,uint256,address,address,address,uint256,bytes32)");
        
        for (uint256 i = 0; i < entries.length; i++) {
