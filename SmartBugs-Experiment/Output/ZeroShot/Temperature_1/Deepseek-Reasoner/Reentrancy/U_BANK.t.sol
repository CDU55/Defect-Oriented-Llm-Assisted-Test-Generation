contract Attacker {
    U_BANK public _victim;
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public _withdrawAmount;

    constructor(address victimAddress) {
        _victim = U_BANK(victimAddress);
    }

