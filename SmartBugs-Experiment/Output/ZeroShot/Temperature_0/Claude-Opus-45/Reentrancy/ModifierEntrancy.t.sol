        _contractUnderTest = new ModifierEntrancy();
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        // No ETH funding needed for this vulnerability - it's about token balance manipulation
        // The vulnerability is in the modifier order: supportsToken calls external contract
        // before hasNoBalance check is fully enforced due to modifier execution order
        
        // Trigger the attack
