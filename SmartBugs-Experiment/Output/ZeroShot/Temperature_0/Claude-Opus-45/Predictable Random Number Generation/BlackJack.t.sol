contract TestWeakRandomnessBlackJack is Test {

    BlackJack public blackJack;

    function setUp() public {
        blackJack = new BlackJack();
        vm.deal(address(blackJack), 100 ether);
        vm.deal(address(this), 100 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockTimestamp, uint256 blockNumber) public {
        
        blockTimestamp = bound(blockTimestamp, 1, type(uint128).max);
        blockNumber = bound(blockNumber, 1, type(uint128).max);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        uint8 predictedPlayerCard0 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(0), blockTimestamp))) % 52);
        uint8 predictedHouseCard0 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(1), blockTimestamp))) % 52);
        uint8 predictedPlayerCard1 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(2), blockTimestamp))) % 52);

        blackJack.deal{value: 0.05 ether}();

        (
            address player,
            uint bet,
            ,
            ,
            ,
            uint8 cardsDealt
        ) = blackJack.games(address(this));

        assertEq(player, address(this), "Player should be set");
        assertEq(bet, 0.05 ether, "Bet should be recorded");
        assertEq(cardsDealt, 3, "Three cards should be dealt");

        uint8 actualPlayerCard0 = blackJack.getPlayerCard(0);
        uint8 actualHouseCard0 = blackJack.getHouseCard(0);
        uint8 actualPlayerCard1 = blackJack.getPlayerCard(1);

        assertEq(actualPlayerCard0, predictedPlayerCard0, "Player card 0 should be predictable");
        assertEq(actualHouseCard0, predictedHouseCard0, "House card 0 should be predictable");
        assertEq(actualPlayerCard1, predictedPlayerCard1, "Player card 1 should be predictable");
    }

    function test_correlationCheckSameBlock(uint256 blockTimestamp, uint256 blockNumber) public {
        blockTimestamp = bound(blockTimestamp, 1, type(uint128).max);
        blockNumber = bound(blockNumber, 1, type(uint128).max);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        address player1 = address(0x1234);
        address player2 = address(0x5678);
        
        vm.deal(player1, 1 ether);
        vm.deal(player2, 1 ether);

        uint8 predictedCard1 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), player1, uint8(0), blockTimestamp))) % 52);
        uint8 predictedCard2 = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), player2, uint8(0), blockTimestamp))) % 52);

        vm.prank(player1);
        blackJack.deal{value: 0.05 ether}();

        vm.prank(player2);
        blackJack.deal{value: 0.05 ether}();

        vm.prank(player1);
        uint8 actualCard1 = blackJack.getPlayerCard(0);

        vm.prank(player2);
        uint8 actualCard2 = blackJack.getPlayerCard(0);

        assertEq(actualCard1, predictedCard1, "Player 1 card should be predictable");
