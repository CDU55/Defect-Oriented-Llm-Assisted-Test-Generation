    function test_highlightPredictableRandomValue(uint256 blockNumber, uint256 blockTimestamp) public {
        vm.assume(blockNumber > 0);
        vm.assume(blockNumber < type(uint256).max - 256);
        vm.assume(blockTimestamp > 0);

        vm.roll(blockNumber);
        vm.warp(blockTimestamp);

        uint256 betAmount = 0.05 ether;
        
        uint8 expectedFirstCard = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(0), blockTimestamp))) % 52);
        uint8 expectedSecondCard = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(1), blockTimestamp))) % 52);
        uint8 expectedThirdCard = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), uint8(2), blockTimestamp))) % 52);

        blackJack.deal{value: betAmount}();

        uint8 actualFirstCard = blackJack.getPlayerCard(0);
        uint8 actualSecondCard = blackJack.getHouseCard(0);
        uint8 actualThirdCard = blackJack.getPlayerCard(1);

        assertEq(actualFirstCard, expectedFirstCard, "First card not predictable");
        assertEq(actualSecondCard, expectedSecondCard, "Second card not predictable");
        assertEq(actualThirdCard, expectedThirdCard, "Third card not predictable");
    }
