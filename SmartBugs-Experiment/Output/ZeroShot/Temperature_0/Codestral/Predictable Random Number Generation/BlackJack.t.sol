pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public blackJack;

    function setUp() public {
        blackJack = new BlackJack();
        vm.deal(address(this), 10 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber, uint256 blockTimestamp) public {
        vm.assume(blockNumber < 2**64);
        vm.assume(blockTimestamp < 2**64);

        vm.startPrank(address(this));
        vm.deal(address(this), 0.1 ether);

        vm.roll(blockNumber);
        vm.warp(blockTimestamp);

        uint8 firstCard = blackJack.deal();
        uint8 secondCard = blackJack.deal();

        uint8 expectedCard = uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), 0, blockTimestamp))) % 52);

        assertEq(firstCard, expectedCard, "First card should match expected value");
        assertEq(secondCard, expectedCard, "Second card should match first card (predictable)");
    }
}
