pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import "../src/Lottery.sol";

contract TestWeakRandomnessLottery is Test {

    Lottery public lottery;

    function setUp() public {
        lottery = new Lottery();
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber > 0);
        vm.assume(blockNumber < type(uint256).max - 1);

        vm.roll(blockNumber);

        uint256 betAmount = 1 ether;
        vm.deal(address(this), betAmount);

        bool expectedWon = (blockNumber % 2) == 0;

        lottery.makeBet{value: betAmount}();

        emit log_named_uint("Block Number", blockNumber);
        emit log_named_bool("Expected Won", expectedWon);

        assertEq(lottery.bets(0).won, expectedWon);
    }
}
