pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public _contractUnderTest;

    function setUp() public {
        _contractUnderTest = new BlackJack();
        vm.deal(address(_contractUnderTest), 10 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber, uint256 blockTimestamp) public {
        vm.assume(blockNumber >= block.number);
        vm.assume(blockTimestamp >= block.timestamp);
        vm.assume(type(uint256).max - blockNumber >= blockTimestamp);

        vm.roll(blockNumber);
        vm.warp(blockTimestamp);

        uint256 firstCall  = _contractUnderTest.deal();
        uint256 secondCall = _contractUnderTest.deal();
        assertEq(firstCall, secondCall, "Output differs within the same block — not purely block-dependent");

        uint256 expectedRandom = uint256(uint8(uint256(keccak256(abi.encodePacked(blockhash(blockNumber), address(this), 0, blockTimestamp))) % 52));

        uint256 actualRandom = _contractUnderTest.getPlayerCard(0);

        assertEq(actualRandom, expectedRandom, "Randomness should be predictable given block state");
    }
}
