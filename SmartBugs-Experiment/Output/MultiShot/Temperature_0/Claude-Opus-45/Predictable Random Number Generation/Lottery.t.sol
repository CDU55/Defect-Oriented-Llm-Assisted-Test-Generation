    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        
        // Constrain block number to reasonable values
        vm.assume(blockNumber >= 1);
        vm.assume(blockNumber <= type(uint128).max);
        
        // Fund this test contract to make bets
        vm.deal(address(this), 10 ether);

        // Manipulate block environment
        vm.roll(blockNumber);

        // Predict the outcome using the same logic as the contract
        // The contract uses: bool won = (block.number % 2) == 0;
        bool expectedWon = (block.number % 2) == 0;

        // Record balance before bet
        uint256 balanceBefore = address(this).balance;
        uint256 betAmount = 1 ether;

        // Execute the bet
        _contractUnderTest.makeBet{value: betAmount}();

        // Record balance after bet
        uint256 balanceAfter = address(this).balance;

        // Determine actual outcome based on balance change
        // If we won, we get our bet back, so balance should be the same
        // If we lost, balance decreases by betAmount
        bool actualWon;
        if (balanceAfter == balanceBefore) {
            actualWon = true;
        } else if (balanceAfter == balanceBefore - betAmount) {
            actualWon = false;
        } else {
            revert("Unexpected balance change");
        }

        // Assert that the outcome matches our prediction
        assertEq(actualWon, expectedWon, "Bet outcome should be predictable based on block.number");
        
        // Additional assertion: verify we can always win by choosing the right block
        // Roll to an even block number (guaranteed win)
        uint256 evenBlock = (blockNumber % 2 == 0) ? blockNumber : blockNumber + 1;
