        uint256 balanceBeforeGuaranteedWin = address(this).balance;
        _contractUnderTest.makeBet{value: betAmount}();
        uint256 balanceAfterGuaranteedWin = address(this).balance;
        
        // On even block, we should always win (get money back)
        assertEq(balanceAfterGuaranteedWin, balanceBeforeGuaranteedWin, "Should always win on even block number");
    }

