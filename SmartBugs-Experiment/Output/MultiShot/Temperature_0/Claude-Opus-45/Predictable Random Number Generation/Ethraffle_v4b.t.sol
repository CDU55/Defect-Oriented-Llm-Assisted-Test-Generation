    function test_highlightPredictableRandomValue(uint256 blockPrevrandao, address blockCoinbase) public {
        
        // Constrain symbolic variables
        vm.assume(blockPrevrandao > 0);
        vm.assume(blockCoinbase != address(0));
        
        // Fund this contract to buy tickets
        vm.deal(address(this), 100 ether);
        
        // Manipulate block environment
        vm.prevrandao(bytes32(blockPrevrandao));
        vm.coinbase(blockCoinbase);

        // Buy 49 tickets first (one less than total to control the final purchase)
        uint256 costFor49Tickets = PRICE_PER_TICKET * 49;
        _contractUnderTest.buyTickets{value: costFor49Tickets}();
        
        // Now we can predict the winning number before buying the last ticket
        // The chooseWinner function uses:
        // - seed1: contestants[uint(uint160(address(block.coinbase))) % totalTickets].addr
        // - seed2: contestants[uint(uint160(address(msg.sender))) % totalTickets].addr
        // - seed3: block.difficulty (which is block.prevrandao post-merge)
        
        // Calculate seed1 - based on coinbase
        uint256 seed1Index = uint256(uint160(blockCoinbase)) % TOTAL_TICKETS;
        address seed1 = address(this); // All tickets are owned by this contract
        
        // Calculate seed2 - based on msg.sender (this contract)
        uint256 seed2Index = uint256(uint160(address(this))) % TOTAL_TICKETS;
        address seed2 = address(this); // All tickets are owned by this contract
        
        // seed3 is block.difficulty (prevrandao)
        uint256 seed3 = blockPrevrandao;
        
        // Calculate expected random hash and winning number
        bytes32 expectedRandHash = keccak256(abi.encodePacked(seed1, seed2, seed3));
        uint256 expectedWinningNumber = uint256(expectedRandHash) % TOTAL_TICKETS;
        
        // Record logs to capture the RaffleResult event
        vm.recordLogs();
        
        // Buy the last ticket to trigger chooseWinner
        _contractUnderTest.buyTickets{value: PRICE_PER_TICKET}();
        
        // Get the emitted logs
        Vm.Log[] memory entries = vm.getRecordedLogs();
        
        // Find the RaffleResult event
        uint256 actualWinningNumber;
        bytes32 actualRandHash;
        bool foundEvent = false;
        
        for (uint256 i = 0; i < entries.length; i++) {
            // RaffleResult event signature
            if (entries[i].topics[0] == keccak256("RaffleResult(uint256,uint256,address,address,address,uint256,bytes32)")) {
                // Decode the event data
                (
                    uint256 raffleId,
                    uint256 winningNumber,
                    address winningAddress,
                    address emittedSeed1,
                    address emittedSeed2,
                    uint256 emittedSeed3,
                    bytes32 randHash
                ) = abi.decode(entries[i].data, (uint256, uint256, address, address, address, uint256, bytes32));
                
                actualWinningNumber = winningNumber;
                actualRandHash = randHash;
                foundEvent = true;
                
                // Verify seeds match our prediction
                assertEq(emittedSeed1, seed1, "Seed1 should match our prediction");
                assertEq(emittedSeed2, seed2, "Seed2 should match our prediction");
                assertEq(emittedSeed3, seed3, "Seed3 should match our prediction");
                break;
            }
        }
        
        assertTrue(foundEvent, "RaffleResult event should have been emitted");
        
        // Assert that the random values are predictable
        assertEq(actualRandHash, expectedRandHash, "Random hash should be predictable given block state");
        assertEq(actualWinningNumber, expectedWinningNumber, "Winning number should be predictable given block state");
    }
    
