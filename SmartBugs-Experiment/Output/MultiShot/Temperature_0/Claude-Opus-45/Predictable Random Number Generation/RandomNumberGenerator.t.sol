pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {RandomNumberGenerator} from "../src/RandomNumberGenerator.sol";

contract TestWeakRandomnessRandomNumberGenerator is Test {

    RandomNumberGenerator public _contractUnderTest;
    uint256 private deploymentTimestamp;

    function setUp() public {
        deploymentTimestamp = block.timestamp;
        _contractUnderTest = new RandomNumberGenerator();
    }

    function test_highlightPredictableRandomValue(uint256 blockTimestamp, uint256 blockNumber) public {
        
        // Constrain blockTimestamp to be >= deployment timestamp (salt value)
        vm.assume(blockTimestamp >= deploymentTimestamp);
        vm.assume(blockTimestamp < type(uint128).max);
        
        // Constrain blockNumber to reasonable values
        vm.assume(blockNumber >= 1);
        vm.assume(blockNumber < type(uint128).max);
        
        // The salt is set at deployment time, so we use deploymentTimestamp as salt
        uint256 salt = deploymentTimestamp;
        
        // Ensure salt % 5 != 0 to avoid division by zero in the contract
        vm.assume(salt % 5 != 0);
        
        // Calculate seed and ensure it's valid for blockhash
        uint256 y = salt * blockNumber / (salt % 5);
        uint256 seed = blockNumber / 3 + (salt % 300) + y;
        
        // blockhash only works for the last 256 blocks, ensure seed is within range
        // For this test, we need seed to be less than blockNumber and within 256 blocks
        vm.assume(seed < blockNumber);
        vm.assume(blockNumber - seed <= 256);
        
        // Set the block environment
        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        // Test with a specific max value
        uint256 max = 100;
        
        // Ensure no division by zero in x calculation
        vm.assume(max > 0);
        
        // Correlation Check: Call the random function twice in the same block
        uint256 firstCall = _contractUnderTest.random(max);
        uint256 secondCall = _contractUnderTest.random(max);
        assertEq(firstCall, secondCall, "Output differs within the same block - not purely block-dependent");

        // Predict the outcome by replicating the vulnerable logic
        uint256 x = salt * 100 / max;
        vm.assume(x > 0); // Avoid division by zero
        
        uint256 h = uint256(blockhash(seed));
        uint256 expectedRandom = uint256((h / x)) % max + 1;

        // Execute the contract method
        uint256 actualRandom = _contractUnderTest.random(max);

        // Assert predictability
        assertEq(actualRandom, expectedRandom, "Randomness should be predictable given block state");
        
        // Verify the result is within expected bounds
        assertGe(actualRandom, 1, "Random number should be >= 1");
        assertLe(actualRandom, max, "Random number should be <= max");
    }

    function test_sameBlockSameResult() public {
        // Set specific block values
        vm.warp(1000);
        vm.roll(1000);
        
        uint256 max = 50;
        
        // Multiple calls in the same block should return the same value
        uint256 result1 = _contractUnderTest.random(max);
        uint256 result2 = _contractUnderTest.random(max);
        uint256 result3 = _contractUnderTest.random(max);
        
        assertEq(result1, result2, "Results should be identical in same block");
        assertEq(result2, result3, "Results should be identical in same block");
    }

    function test_attackerCanPredictOutcome() public {
