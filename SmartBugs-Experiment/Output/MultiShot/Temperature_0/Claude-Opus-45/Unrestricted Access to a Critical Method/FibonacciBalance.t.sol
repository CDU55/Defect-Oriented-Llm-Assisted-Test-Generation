import {Test} from "../lib/forge-std/src/Test.sol";
import {FibonacciBalance, FibonacciLib} from "../src/FibonacciBalance.sol";

// ═══════════════════════════════════════════════════════════════════════════════
// [Testing Goal] Verify if critical methods are properly protected by ensuring
// that unauthorized addresses cannot reach or modify a sensitive contract state.
// ═══════════════════════════════════════════════════════════════════════════════

contract TestAccessControlFibonacciBalance is Test {

    FibonacciBalance public _contractUnderTest;
    FibonacciLib public _fibonacciLib;

    function setUp() public {
        // Deploy the FibonacciLib library contract first
        _fibonacciLib = new FibonacciLib();
        
        // Fund this contract so we can deploy FibonacciBalance with ether
        vm.deal(address(this), 100 ether);
        
        // Deploy FibonacciBalance with initial funding
        _contractUnderTest = new FibonacciBalance{value: 50 ether}(address(_fibonacciLib));
    }

    function test_highlightArbitraryUserCanAccess(address caller) public {
        
        // Constrain the 'caller'.
        // 1. Caller cannot be the test contract itself.
        vm.assume(caller != address(this));
        // 2. Exclude the Zero Address
        vm.assume(caller != address(0));

        // 3. Exclude Foundry Internals (Dynamic)
        vm.assume(caller != address(vm)); 
        // Exclude the Console address
        vm.assume(caller != 0x000000000000000000636F6e736F6c652e6c6f67);
        
        // The withdraw function has NO access control - there are no privileged roles to exclude.
        // Any address can call withdraw() and drain funds from the contract.
        // This is the vulnerability we are testing.

        // Record the initial state
        uint256 initialContractBalance = address(_contractUnderTest).balance;
        uint256 initialCallerBalance = caller.balance;
        uint256 initialWithdrawalCounter = _contractUnderTest.withdrawalCounter();
        
        // Ensure the contract has enough balance for the withdrawal
        // First withdrawal (counter=1) will calculate fibonacci(1) = start + 1 = 3 + 1 = 4
        // So it will try to transfer 4 ether
        require(initialContractBalance >= 4 ether, "Contract needs sufficient balance");

        // Switch context to the arbitrary caller
        vm.prank(caller);

        // TRIGGER THE SENSITIVE METHOD
        // The withdraw() function has no access control - anyone can call it
        // If the contract is VULNERABLE (Unprotected): the call SUCCEEDS → test PASSES.
        // If the contract is SECURE (Protected): the call REVERTS → test FAILS.
        _contractUnderTest.withdraw();

        // ASSERT STATE CHANGE
        // Verify that the withdrawal counter was incremented
        assertEq(_contractUnderTest.withdrawalCounter(), initialWithdrawalCounter + 1, "Withdrawal counter should be incremented");
        
        // Verify that the caller received ether (proving the unauthorized withdrawal succeeded)
        // The fibonacci calculation for n=1 with start=3 gives: start + 1 = 4
        // So 4 ether should be transferred
        uint256 expectedWithdrawal = 4 ether;
        assertEq(caller.balance, initialCallerBalance + expectedWithdrawal, "Caller should have received ether");
        
        // Verify the contract balance decreased
        assertEq(address(_contractUnderTest).balance, initialContractBalance - expectedWithdrawal, "Contract balance should have decreased");
    }
}
