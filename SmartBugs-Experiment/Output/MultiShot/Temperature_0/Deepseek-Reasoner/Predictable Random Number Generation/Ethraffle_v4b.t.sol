pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Ethraffle_v4b} from "../src/Ethraffle_v4b.sol";

contract TestWeakRandomnessEthraffle_v4b is Test {
    Ethraffle_v4b public _contractUnderTest;
    uint256 public constant TOTAL_TICKETS = 50;
    uint256 public constant PRICE_PER_TICKET = (2.5 ether + 0.03 ether) / TOTAL_TICKETS;

    function setUp() public {
        _contractUnderTest = new Ethraffle_v4b();
    }

    function test_highlightPredictableRandomValue(
        address blockCoinbase,
        uint256 blockPrevrandao,
        address caller
    ) public {
        vm.assume(caller != address(0));
        vm.assume(blockCoinbase != address(0));

        vm.coinbase(blockCoinbase);
        vm.prevrandao(bytes32(blockPrevrandao));

        uint256 totalCost = PRICE_PER_TICKET * TOTAL_TICKETS;
        vm.deal(caller, totalCost);

        for (uint256 i = 0; i < TOTAL_TICKETS; i++) {
            vm.prank(caller);
            _contractUnderTest.buyTickets{value: PRICE_PER_TICKET}();
        }

        uint256 seed1Index = uint256(uint160(blockCoinbase)) % TOTAL_TICKETS;
        uint256 seed2Index = uint256(uint160(caller)) % TOTAL_TICKETS;
        address seed1 = caller;
        address seed2 = caller;
        uint256 seed3 = blockPrevrandao;
        bytes32 randHash = keccak256(abi.encodePacked(seed1, seed2, seed3));
        uint256 expectedWinningNumber = uint256(randHash) % TOTAL_TICKETS;

        address seed1Expected = caller;
        address seed2Expected = caller;
        uint256 seed3Expected = blockPrevrandao;
        bytes32 randHashExpected = keccak256(abi.encodePacked(seed1Expected, seed2Expected, seed3Expected));
        uint256 expectedWinningNumberCheck = uint256(randHashExpected) % TOTAL_TICKETS;

        assertEq(expectedWinningNumber, expectedWinningNumberCheck, "Randomness should be predictable given block state");
    }
}
