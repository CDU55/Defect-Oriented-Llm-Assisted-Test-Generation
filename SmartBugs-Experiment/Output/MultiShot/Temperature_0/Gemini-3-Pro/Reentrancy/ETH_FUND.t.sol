        // MinDeposit is 1 ether. We need > 1 ether to deposit.
        // We multiply by 2 for the deposit to allow 2 withdrawals without underflow in Solidity 0.8.x
        vm.assume(attackVal > 1.1 ether && attackVal < 1000 ether);
        uint256 depositAmount = attackVal * 2;

        vm.deal(address(_contractUnderTest), depositAmount * 10); 
