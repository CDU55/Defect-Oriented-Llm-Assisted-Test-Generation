pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Ethraffle_v4b} from "../src/Ethraffle_v4b.sol";

contract TestWeakRandomnessEthraffle_v4b is Test {

    Ethraffle_v4b public _contractUnderTest;

    function setUp() public {
        _contractUnderTest = new Ethraffle_v4b();
    }

    function test_highlightPredictableRandomValue(address blockCoinbase, uint256 blockPrevrandao) public {
        
        vm.assume(blockCoinbase != address(0));
        
        vm.coinbase(blockCoinbase);
        vm.prevrandao(bytes32(blockPrevrandao));

        uint256 totalTickets = _contractUnderTest.totalTickets();
        uint256 pricePerTicket = _contractUnderTest.pricePerTicket();

        vm.deal(address(this), pricePerTicket * totalTickets + 1 ether);

        // Fill the raffle up to the last ticket
        for (uint i = 0; i < totalTickets - 1; i++) {
            _contractUnderTest.buyTickets{value: pricePerTicket}();
        }

        // Replicate the logic to predict the winner before the transaction is finalized
        // Since we (address(this)) bought all tickets, any index in contestants maps to address(this).
        // Even the 50th ticket (index 49) which is about to be bought will be address(this).
        
        address seed1 = address(this); // contestants[uint(uint160(blockCoinbase)) % totalTickets].addr
        address seed2 = address(this); // contestants[uint(uint160(address(this))) % totalTickets].addr
        uint seed3 = blockPrevrandao;  // block.difficulty
        
        bytes32 randHash = keccak256(abi.encodePacked(seed1, seed2, seed3));
        uint256 expectedWinningNumber = uint(randHash) % totalTickets;

        vm.recordLogs();
        
        // Buy the final ticket to trigger chooseWinner()
        _contractUnderTest.buyTickets{value: pricePerTicket}();

        Vm.Log[] memory entries = vm.getRecordedLogs();
        bool eventFound = false;
        
        // RaffleResult signature: RaffleResult(uint,uint,address,address,address,uint,bytes32)
        bytes32 eventSignature = keccak256("RaffleResult(uint256,uint256,address,address,address,uint256,bytes32)");

        for (uint i = 0; i < entries.length; i++) {
            if (entries[i].topics[0] == eventSignature) {
                (, uint winningNumber, , , , , ) = abi.decode(entries[i].data, (uint, uint, address, address, address, uint, bytes32));
                
                assertEq(winningNumber, expectedWinningNumber, "Randomness should be predictable given block state");
                eventFound = true;
            }
        }
        
        assertTrue(eventFound, "RaffleResult event should have been emitted");
    }

    receive() external payable {}
}
