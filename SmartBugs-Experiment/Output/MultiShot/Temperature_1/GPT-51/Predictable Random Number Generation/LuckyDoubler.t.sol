pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {LuckyDoubler} from "../src/LuckyDoubler.sol";

contract TestWeakRandomnessLuckyDoubler is Test {
    LuckyDoubler public luckyDoubler;

    uint256 constant private FACTOR =
        1157920892373161954235709850086879078532699846656405640394575840079131296399;

    function setUp() public {
        luckyDoubler = new LuckyDoubler();
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber > 1);
        vm.roll(blockNumber);

        address alice = address(0xA11CE);
        address bob = address(0xB0B);

        vm.deal(alice, 10 ether);
        vm.deal(bob, 10 ether);

        vm.prank(alice);
        (bool success1, ) = address(luckyDoubler).call{value: 1 ether}("");
        require(success1, "alice join failed");

        uint256 max = 2;
        uint256 factor = FACTOR * 100 / max;
        uint256 lastBlockNumber = block.number - 1;
        uint256 hashVal = uint256(blockhash(lastBlockNumber));
        uint256 expectedIndex = (hashVal / factor) % max;

        vm.prank(bob);
        (bool success2, ) = address(luckyDoubler).call{value: 1 ether}("");
        require(success2, "bob join failed");

        (address user0, , bool paid0, ) = luckyDoubler.entryDetails(0);
        (address user1, , bool paid1, ) = luckyDoubler.entryDetails(1);

        assertEq(user0, alice, "entry 0 should belong to Alice");
        assertEq(user1, bob, "entry 1 should belong to Bob");

        if (expectedIndex == 0) {
            assertTrue(paid0, "entry 0 should have been paid");
            assertFalse(paid1, "entry 1 should not have been paid");
        } else {
            assertEq(expectedIndex, 1, "random index must be 0 or 1");
            assertTrue(paid1, "entry 1 should have been paid");
            assertFalse(paid0, "entry 0 should not have been paid");
        }
    }
}
