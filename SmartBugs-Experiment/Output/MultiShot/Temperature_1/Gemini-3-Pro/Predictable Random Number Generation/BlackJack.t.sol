pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public blackJack;

    function setUp() public {
        blackJack = new BlackJack();
        vm.deal(address(this), 100 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber, uint256 blockTimestamp) public {
        
        vm.assume(blockTimestamp > 0);
        vm.assume(blockNumber > 0);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        // Predict the random outcome using the same inputs as the contract
        // In the executing transaction, blockhash(block.number) returns 0
        bytes32 predictedBlockHash = bytes32(0);
        address player = address(this);

        // The contract deals 3 cards sequentially: (0, 1, 2)
        uint8 expectedCard0 = uint8(uint256(keccak256(abi.encodePacked(predictedBlockHash, player, uint8(0), blockTimestamp))) % 52);
        uint8 expectedCard1 = uint8(uint256(keccak256(abi.encodePacked(predictedBlockHash, player, uint8(1), blockTimestamp))) % 52);
        uint8 expectedCard2 = uint8(uint256(keccak256(abi.encodePacked(predictedBlockHash, player, uint8(2), blockTimestamp))) % 52);

        vm.recordLogs();
        
        blackJack.deal{value: 1 ether}();

        // Extract emitted events to verify randomness
        Vm.Log[] memory entries = vm.getRecordedLogs();
        uint8[] memory actualCards = new uint8[](3);
        uint found = 0;
        bytes32 sig = keccak256("Deal(bool,uint8)");

        for (uint i = 0; i < entries.length; i++) {
            if (entries[i].topics[0] == sig) {
                // Event: Deal(bool isUser, uint8 _card)
                (, uint8 card) = abi.decode(entries[i].data, (bool, uint8));
                if (found < 3) {
                    actualCards[found] = card;
                }
                found++;
            }
        }

        assertEq(actualCards[0], expectedCard0, "First card should be predictable based on block state");
        assertEq(actualCards[1], expectedCard1, "Second card should be predictable based on block state");
        assertEq(actualCards[2], expectedCard2, "Third card should be predictable based on block state");
    }
}
