pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {BlackJack} from "../src/BlackJack.sol";

contract TestWeakRandomnessBlackJack is Test {

    BlackJack public _contractUnderTest;

    event Deal(bool isUser, uint8 _card);

    function setUp() public {
        _contractUnderTest = new BlackJack();
        vm.deal(address(_contractUnderTest), 100 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockTimestamp, uint256 blockNumber) public {
        vm.assume(blockTimestamp >= block.timestamp);
        vm.assume(blockNumber >= block.number);
        vm.assume(blockNumber < type(uint256).max - 1000);
        vm.assume(blockTimestamp < type(uint256).max - 1000);

        vm.deal(address(this), 100 ether);

        vm.warp(blockTimestamp);
        vm.roll(blockNumber);

        address player = address(this);

        // Predict the cards using the same logic as Deck.deal
        // Note: blockhash(block.number) returns bytes32(0) for the current block
        bytes32 bhash = blockhash(blockNumber);
        
        uint8 expectedPlayerCard0 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(0), blockTimestamp))) % 52);
        uint8 expectedHouseCard0 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(1), blockTimestamp))) % 52);
        uint8 expectedPlayerCard1 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(2), blockTimestamp))) % 52);

        // Record logs to capture Deal events
        vm.recordLogs();

        _contractUnderTest.deal{value: 0.05 ether}();

        Vm.Log[] memory entries = vm.getRecordedLogs();

        // Extract actual cards from Deal events
        uint8 actualPlayerCard0;
        uint8 actualHouseCard0;
        uint8 actualPlayerCard1;

        bytes32 dealEventSelector = keccak256("Deal(bool,uint8)");
        uint dealEventCount = 0;

        for (uint i = 0; i < entries.length; i++) {
            if (entries[i].topics[0] == dealEventSelector) {
                (bool isUser, uint8 card) = abi.decode(entries[i].data, (bool, uint8));
                if (dealEventCount == 0) {
                    actualPlayerCard0 = card;
                    assertTrue(isUser, "First card should be for player");
                } else if (dealEventCount == 1) {
                    actualHouseCard0 = card;
                    assertFalse(isUser, "Second card should be for house");
                } else if (dealEventCount == 2) {
                    actualPlayerCard1 = card;
                    assertTrue(isUser, "Third card should be for player");
                }
                dealEventCount++;
            }
        }

        assertEq(dealEventCount, 3, "Should have 3 Deal events");

        // Assert that all cards are predictable given the block state
        assertEq(actualPlayerCard0, expectedPlayerCard0, "Player card 0 should be predictable given block state");
        assertEq(actualHouseCard0, expectedHouseCard0, "House card 0 should be predictable given block state");
        assertEq(actualPlayerCard1, expectedPlayerCard1, "Player card 1 should be predictable given block state");
    }

    function test_sameBlockProducesSameCards() public {
        vm.deal(address(this), 100 ether);

        uint256 fixedTimestamp = 1700000000;
        uint256 fixedBlockNumber = 1000000;

        vm.warp(fixedTimestamp);
        vm.roll(fixedBlockNumber);

        address player = address(this);
        bytes32 bhash = blockhash(fixedBlockNumber);

        // Calculate expected cards
        uint8 expectedPlayerCard0 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(0), fixedTimestamp))) % 52);
        uint8 expectedHouseCard0 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(1), fixedTimestamp))) % 52);
        uint8 expectedPlayerCard1 = uint8(uint256(keccak256(abi.encodePacked(bhash, player, uint8(2), fixedTimestamp))) % 52);

        vm.recordLogs();
        _contractUnderTest.deal{value: 0.05 ether}();
        Vm.Log[] memory entries = vm.getRecordedLogs();

        bytes32 dealEventSelector = keccak256("Deal(bool,uint8)");
        uint8[3] memory actualCards;
        uint cardIndex = 0;

        for (uint i = 0; i < entries.length && cardIndex < 3; i++) {
            if (entries[i].topics[0] == dealEventSelector) {
                (, uint8 card) = abi.decode(entries[i].data, (bool, uint8));
                actualCards[cardIndex] = card;
                cardIndex++;
            }
        }

        assertEq(actualCards[0], expectedPlayerCard0, "Player card 0 predictable");
        assertEq(actualCards[1], expectedHouseCard0, "House card 0 predictable");
        assertEq(actualCards[2], expectedPlayerCard1, "Player card 1 predictable");
    }

    receive() external payable {}
}
