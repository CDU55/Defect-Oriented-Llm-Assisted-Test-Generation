        // Verify that blockhash for the target block now returns 0 (predictable)
        bytes32 actualBlockhash = blockhash(targetBlock);
        assertEq(actualBlockhash, bytes32(0), "Blockhash should be 0 for blocks older than 256");

        // Replicate the vulnerable logic: answer = blockhash(targetBlock)
        bytes32 expectedAnswer = blockhash(targetBlock);
        assertEq(expectedAnswer, predictedAnswer, "Randomness should be predictable given block state");

