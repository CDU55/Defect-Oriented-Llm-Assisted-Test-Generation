pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Lottery} from "../src/Lottery.sol";

contract TestWeakRandomnessLottery is Test {

    Lottery public _contractUnderTest;

    function setUp() public {
        _contractUnderTest = new Lottery();
        vm.deal(address(_contractUnderTest), 100 ether);
    }

    function test_highlightPredictableRandomValue(uint256 blockNumber) public {
        vm.assume(blockNumber >= 1);
        vm.assume(blockNumber < type(uint128).max);

        vm.deal(address(this), 100 ether);

        vm.roll(blockNumber);

        bool expectedWon = (block.number % 2) == 0;

        uint256 balanceBefore = address(this).balance;
        uint256 betAmount = 1 ether;

        _contractUnderTest.makeBet{value: betAmount}();

        uint256 balanceAfter = address(this).balance;
        bool actualWon = (balanceAfter == balanceBefore);

        assertEq(actualWon, expectedWon, "Randomness should be predictable given block state");
    }

    function test_correlationCheckSameBlock() public {
        vm.deal(address(this), 100 ether);
        
        uint256 testBlockNumber = 42;
        vm.roll(testBlockNumber);

        bool expectedOutcome = (block.number % 2) == 0;

        uint256 balanceBefore1 = address(this).balance;
        _contractUnderTest.makeBet{value: 1 ether}();
        uint256 balanceAfter1 = address(this).balance;
        bool firstCallWon = (balanceAfter1 == balanceBefore1);

        uint256 balanceBefore2 = address(this).balance;
        _contractUnderTest.makeBet{value: 1 ether}();
        uint256 balanceAfter2 = address(this).balance;
        bool secondCallWon = (balanceAfter2 == balanceBefore2);

        assertEq(firstCallWon, secondCallWon, "Output differs within the same block - not purely block-dependent");
        assertEq(firstCallWon, expectedOutcome, "Outcome should match predicted value");
    }

    function test_exploitAlwaysWinOnEvenBlock() public {
        vm.deal(address(this), 100 ether);

        uint256 evenBlockNumber = 100;
        vm.roll(evenBlockNumber);

        uint256 balanceBefore = address(this).balance;
        uint256 betAmount = 1 ether;

        _contractUnderTest.makeBet{value: betAmount}();

        uint256 balanceAfter = address(this).balance;

        assertEq(balanceAfter, balanceBefore, "Attacker should always win on even blocks");
    }

    function test_exploitAlwaysLoseOnOddBlock() public {
        vm.deal(address(this), 100 ether);

        uint256 oddBlockNumber = 101;
        vm.roll(oddBlockNumber);

        uint256 balanceBefore = address(this).balance;
        uint256 betAmount = 1 ether;

        _contractUnderTest.makeBet{value: betAmount}();

        uint256 balanceAfter = address(this).balance;

        assertEq(balanceAfter, balanceBefore - betAmount, "Bet should be lost on odd blocks");
    }

    receive() external payable {}
