        uint256 newLastBlockNumber = block.number - 1;
        uint256 newHashVal = uint256(blockhash(newLastBlockNumber));
        uint256 newExpectedIndex = (newHashVal / newFactor) % maxEntries;
        
        assertEq(newBlockPrediction, newExpectedIndex, "Attacker can predict random value in any future block");
