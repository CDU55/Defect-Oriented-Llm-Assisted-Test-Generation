pragma solidity 0.8.29;

import {Test} from "../lib/forge-std/src/Test.sol";
import {FibonacciBalance, FibonacciLib} from "../src/FibonacciBalance.sol";

contract TestAccessControlFibonacciBalance is Test {

    FibonacciBalance public _contractUnderTest;
    FibonacciLib public fibLib;

    function setUp() public {
        fibLib = new FibonacciLib();
        vm.deal(address(this), 1000 ether);
        _contractUnderTest = new FibonacciBalance{value: 100 ether}(address(fibLib));
    }

    function test_highlightArbitraryUserCanAccess(address caller) public {
        
        vm.assume(caller != address(this));
        vm.assume(caller != address(0));
        vm.assume(caller != address(vm)); 
        vm.assume(caller != 0x000000000000000000636F6e736F6c652e6c6f67);
        vm.assume(caller != address(_contractUnderTest));
        vm.assume(caller != address(fibLib));

        uint256 initialCounter = _contractUnderTest.withdrawalCounter();
        uint256 callerBalanceBefore = caller.balance;

        vm.deal(address(_contractUnderTest), type(uint128).max);

        vm.prank(caller);
        _contractUnderTest.withdraw();

        assertEq(
            _contractUnderTest.withdrawalCounter(), 
            initialCounter + 1, 
            "Withdrawal counter should have incremented - unauthorized access succeeded"
        );
        
        assertGt(
            caller.balance, 
            callerBalanceBefore, 
            "Caller received funds without authorization"
        );
    }
}
